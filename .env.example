# Database
POSTGRES_DB=certs
POSTGRES_USER=certs
POSTGRES_PASSWORD=certs

# Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://certs:certs@db:5432/certs?schema=public

# Auth (dev)
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=12h

# Dev bootstrap (creates default users + demo data if missing)
DEV_BOOTSTRAP=true

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Creator (enters exam attempts)
CREATOR_EMAIL=creator@example.com
CREATOR_PASSWORD=creator123

# Signer (approves/rejects)
SIGNER_EMAIL=signer@example.com
SIGNER_PASSWORD=signer123

# Frontend (baked at build time)
VITE_API_URL=http://localhost:3000

# Storage for template backgrounds (backend container path)
TEMPLATE_STORAGE_DIR=/app/data/templates

# Base URL used for QR / verify links in generated PDFs
PUBLIC_VERIFY_BASE_URL=http://localhost:3000

# PDF generation
NODE_ENV=development
PDF_FONT_PATH=/app/assets/fonts/DejaVuSans.ttf
