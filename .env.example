# Database
POSTGRES_DB=certs
POSTGRES_USER=certs
POSTGRES_PASSWORD=certs

# Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://certs:certs@db:5432/certs?schema=public

# Auth (dev)
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=12h

# Dev bootstrap (creates default admin + demo cert if missing)
DEV_BOOTSTRAP=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Frontend (baked at build time)
VITE_API_URL=http://localhost:3000
