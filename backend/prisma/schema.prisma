generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Grade {
  gold
  silver
  fail
}

enum CertificateStatus {
  pending
  issued
  revoked
  annulled
}

enum AttemptStatus {
  draft
  submitted
  needs_fix
  approved
  rejected
  failed
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum ValidityType {
  fixed_date
  duration
  perpetual
}

model AppUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  roles          UserRole[]
  createdAttempts ExamAttempt[] @relation("AttemptCreator")
  signingAttempts ExamAttempt[] @relation("AttemptSigner")
  approvals       Approval[]    @relation("ApprovalSigner")

  // Templates this user created
  createdTemplates       Template[]        @relation("TemplateCreator")
  createdTemplateVersions TemplateVersion[] @relation("TemplateVersionCreator")

  // Certificates this user revoked/annulled
  revokedCertificates Certificate[] @relation("CertificateRevokedBy")

  // Certificates this user edited (revision flow)
  editedCertificates  Certificate[] @relation("CertificateEditedBy")
}

model Role {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Person {
  id           String   @id @default(uuid())
  fullName     String
  position     String
  employeeCode String?  @unique
  createdAt    DateTime @default(now())

  attempts     ExamAttempt[]
}

model ExamType {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  // Default certificate validity rules
  defaultValidityType   ValidityType @default(duration)
  defaultValidityMonths Int          @default(36)
  // Used when defaultValidityType = fixed_date (optional)
  defaultValidTo        DateTime?

  attempts     ExamAttempt[]

  // Optional default template version for this exam type
  defaultTemplateVersionId String?
  defaultTemplateVersion   TemplateVersion? @relation("ExamTypeDefaultTemplate", fields: [defaultTemplateVersionId], references: [id], onDelete: SetNull)

  // Counters for sequential certificate numbers
  counters     CertificateCounter[]

  @@index([defaultTemplateVersionId])
}

model ExamAttempt {
  id           String        @id @default(uuid())
  personId     String
  examTypeId   String
  attemptNo    Int
  grade        Grade
  examDate     DateTime      @default(now())
  status       AttemptStatus @default(draft)
  signerUserId String?
  createdById  String
  // Optional template version chosen for certificate issuance
  templateVersionId String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  person      Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  examType    ExamType @relation(fields: [examTypeId], references: [id], onDelete: Restrict)
  createdBy   AppUser  @relation("AttemptCreator", fields: [createdById], references: [id], onDelete: Restrict)
  signerUser  AppUser? @relation("AttemptSigner", fields: [signerUserId], references: [id], onDelete: SetNull)
  templateVersion TemplateVersion? @relation("AttemptTemplateVersion", fields: [templateVersionId], references: [id], onDelete: SetNull)

  approvals   Approval[]
  certificate Certificate?

  @@unique([personId, examTypeId, attemptNo])
  @@index([status])
  @@index([signerUserId])
  @@index([createdById])
  @@index([examDate])
  @@index([templateVersionId])
}

model Approval {
  id            String         @id @default(uuid())
  examAttemptId String
  signerUserId  String
  status        ApprovalStatus @default(pending)
  // True if this approval was created after editing an already issued certificate
  isRevision    Boolean        @default(false)
  // Optional note shown to signer for revision approvals
  note          String?
  reason        String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  examAttempt ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  signerUser  AppUser     @relation("ApprovalSigner", fields: [signerUserId], references: [id], onDelete: Restrict)

  @@index([signerUserId, status])
  @@index([examAttemptId])
}

model Certificate {
  id                String            @id @default(uuid())
  certificateNumber String            @unique
  publicId          String            @unique
  grade             Grade
  status            CertificateStatus @default(issued)

  issuedAt          DateTime          @default(now())
  validityType      ValidityType      @default(duration)
  validityMonths    Int?

  validFrom         DateTime          @default(now())
  validTo           DateTime?

  revokedAt         DateTime?
  revokedById       String?
  revokeReason      String?

  // For deterministic PDF render (internal only)
  renderSnapshotJson Json?

  // Template used for deterministic PDF generation
  templateVersionId  String?
  templateVersion    TemplateVersion? @relation("CertificateTemplateVersion", fields: [templateVersionId], references: [id], onDelete: SetNull)

  // Revision info (when an issued certificate was edited and sent for re-sign)
  editedAt           DateTime?
  editedById         String?
  editNote           String?
  editedBy           AppUser?          @relation("CertificateEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  // Certificate belongs to a specific attempt
  examAttemptId     String            @unique
  examAttempt       ExamAttempt       @relation(fields: [examAttemptId], references: [id], onDelete: Restrict)

  revokedBy         AppUser?          @relation("CertificateRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())

  @@index([status])
  @@index([issuedAt])
  @@index([validTo])
  @@index([templateVersionId])
}

model CertificateCounter {
  id        String   @id @default(uuid())
  examTypeId String
  year      Int
  seq       Int
  updatedAt DateTime @updatedAt

  examType ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@unique([examTypeId, year])
}


model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String?

  createdBy AppUser? @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions  TemplateVersion[]
}

model TemplateVersion {
  id            String   @id @default(uuid())
  templateId    String
  version       Int
  isActive      Boolean  @default(true)
  backgroundPath String?
  configJson    Json?
  createdAt     DateTime @default(now())
  createdById   String?

  template  Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy AppUser?  @relation("TemplateVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  certificates Certificate[] @relation("CertificateTemplateVersion")
  attempts     ExamAttempt[] @relation("AttemptTemplateVersion")
  defaultForExamTypes ExamType[] @relation("ExamTypeDefaultTemplate")

  @@unique([templateId, version])
  @@index([templateId, isActive])
}
