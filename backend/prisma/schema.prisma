generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Grade {
  gold
  silver
  fail
}

enum CertificateStatus {
  issued
  revoked
  annulled
}

enum AttemptStatus {
  draft
  submitted
  needs_fix
  approved
  rejected
  failed
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

model AppUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  roles          UserRole[]
  createdAttempts ExamAttempt[] @relation("AttemptCreator")
  signingAttempts ExamAttempt[] @relation("AttemptSigner")
  approvals       Approval[]    @relation("ApprovalSigner")
}

model Role {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Person {
  id           String   @id @default(uuid())
  fullName     String
  position     String
  employeeCode String?  @unique
  createdAt    DateTime @default(now())

  attempts     ExamAttempt[]
  certificates Certificate[]
}

model ExamType {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  attempts     ExamAttempt[]
  certificates Certificate[]
}

model ExamAttempt {
  id           String        @id @default(uuid())
  personId     String
  examTypeId   String
  attemptNo    Int
  grade        Grade
  examDate     DateTime      @default(now())
  status       AttemptStatus @default(draft)
  signerUserId String?
  createdById  String
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  person      Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  examType    ExamType @relation(fields: [examTypeId], references: [id], onDelete: Restrict)
  createdBy   AppUser  @relation("AttemptCreator", fields: [createdById], references: [id], onDelete: Restrict)
  signerUser  AppUser? @relation("AttemptSigner", fields: [signerUserId], references: [id], onDelete: SetNull)

  approvals   Approval[]
  certificate Certificate?

  @@unique([personId, examTypeId, attemptNo])
  @@index([status])
  @@index([signerUserId])
  @@index([createdById])
  @@index([examDate])
}

model Approval {
  id            String         @id @default(uuid())
  examAttemptId String
  signerUserId  String
  status        ApprovalStatus @default(pending)
  reason        String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  examAttempt ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  signerUser  AppUser     @relation("ApprovalSigner", fields: [signerUserId], references: [id], onDelete: Restrict)

  @@index([signerUserId, status])
  @@index([examAttemptId])
}

model Certificate {
  id                String            @id @default(uuid())
  certificateNumber String            @unique
  publicId          String            @unique
  grade             Grade
  status            CertificateStatus @default(issued)

  issuedAt          DateTime          @default(now())
  validFrom         DateTime          @default(now())
  validTo           DateTime?

  // For deterministic PDF render (internal only)
  renderSnapshotJson Json?

  // Legacy links (kept for demo + transition)
  personId          String?
  person            Person?           @relation(fields: [personId], references: [id], onDelete: SetNull)

  examTypeId        String?
  examType          ExamType?         @relation(fields: [examTypeId], references: [id], onDelete: SetNull)

  // Future: certificate belongs to an attempt
  examAttemptId     String?           @unique
  examAttempt       ExamAttempt?      @relation(fields: [examAttemptId], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())

  @@index([status])
  @@index([issuedAt])
  @@index([validTo])
}
